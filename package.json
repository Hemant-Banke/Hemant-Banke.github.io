{
  "name": "ascii-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen": "node scripts/gen-content.mjs",
    "gen:graph": "node scripts/gen-graph-layout.mjs",
