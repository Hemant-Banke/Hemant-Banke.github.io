    "preview": "vite preview",
    "typecheck": "npm run gen && tsc -b --noEmit"
  },
  "dependencies": {
    "d3-force": "^3.0.0",
    "figlet": "^1.11.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/figlet": "^1.7.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.1.0",
    "slugify": "^1.6.6",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
